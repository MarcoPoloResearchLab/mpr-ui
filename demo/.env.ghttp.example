# Documentation only: never source, copy, or use this file as runtime configuration.
# Operational values are intentionally goofy and non-operational. Create a private ignored env file.
# Boolean, numeric, and enum entries remain type-valid documentation, not runnable defaults.

# gHTTP configuration for mpr-ui demo
# Create a private ignored environment file and configure it explicitly.

# Internal container port (external port 4443 maps to this in docker-compose.yml)
GHTTP_SERVE_PORT=4242

# Serve the repository root so /demo/*, /docs/*, /mpr-ui.js, and /mpr-ui.css
# are reachable from the same origin.
GHTTP_SERVE_DIRECTORY=/tmp/goofy-do-not-use/disco-pickle

# HTTPS with existing certificates (required for GIS to render)
# Mount your certificates in docker-compose.yml and reference the container paths here
GHTTP_SERVE_TLS_CERTIFICATE=/tmp/goofy-do-not-use/disco-pickle.pem
GHTTP_SERVE_TLS_PRIVATE_KEY=/tmp/goofy-do-not-use/spaghetti-yeti.pem

# Reverse proxy configuration for TAuth endpoints (same-origin operation)
# All auth demos use the same-origin proxy for the configured /auth/* routes.
# Format: /from=http://backend (request path is preserved, so /auth/nonce -> http://tauth:8080/auth/nonce)
GHTTP_SERVE_PROXIES=/goofy/*=https://turbo-turnip.invalid
