# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:1.26.5 AS source
WORKDIR /workspace/tauth
COPY --from=tauth_source go.mod go.sum ./
COPY --from=tauth_source cmd/ ./cmd/
COPY --from=tauth_source internal/ ./internal/
COPY --from=tauth_source pkg/ ./pkg/
COPY --from=pingwin_source go.mod go.sum /workspace/pingwin/
COPY --from=pingwin_source pkg/ /workspace/pingwin/pkg/
RUN go work init . /workspace/pingwin

FROM source AS server-build
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /out/tauth ./cmd/server

FROM source AS delivery-build
COPY tests/integration/fixtures/tauth_delivery.go ./cmd/mpr-ui-delivery/main.go
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /out/tauth-delivery ./cmd/mpr-ui-delivery

FROM alpine:3.20 AS runtime
RUN apk add --no-cache ca-certificates

FROM runtime AS delivery-check
COPY --from=delivery-build /out/tauth-delivery /usr/local/bin/tauth-delivery
ENTRYPOINT ["/usr/local/bin/tauth-delivery"]

FROM runtime AS tauth
COPY --from=server-build /out/tauth /usr/local/bin/tauth
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/tauth"]
